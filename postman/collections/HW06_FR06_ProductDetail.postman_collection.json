{
  "info": {
    "name": "HW06_FR06_ProductDetail",
    "description": "FR06 Product Detail — spec-based assertions — data-driven via postman/data/*.csv (Collection Runner + Newman -d).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "fr06_tc033_body",
      "value": ""
    },
    {
      "key": "fr06_ext006_p1",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.environment.get('studentId') || '23127273' });",
          "console.log('X-Student-Id:', pm.environment.get('studentId') || '23127273');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Setup — Login test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login test user', () => pm.response.to.have.status(200));",
                  "pm.environment.set('authToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup — Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login admin', () => pm.response.to.have.status(200));",
                  "pm.environment.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Data-Driven Tests",
      "item": [
        {
          "name": "{{tc_id}} — {{description}}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.iterationData.toObject();",
                  "const base = pm.environment.get('baseUrl');",
                  "",
                  "function applyAuth(mode) {",
                  "  pm.request.headers.remove('Authorization');",
                  "  pm.request.headers.remove('authorization');",
                  "  if (mode === 'none') return;",
                  "  if (mode === 'remove') return;",
                  "  if (mode === 'user') {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('authToken') });",
                  "    return;",
                  "  }",
                  "  if (mode === 'admin') {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('adminToken') });",
                  "    return;",
                  "  }",
                  "  if (mode === 'cartFresh') {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('cartFreshToken') });",
                  "    return;",
                  "  }",
                  "  if (mode === 'invalid') {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer invalid' });",
                  "    return;",
                  "  }",
                  "  if (mode === 'invalid_garbage') {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer invalid-token-garbage' });",
                  "    return;",
                  "  }",
                  "  if (mode === 'garbage') {",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer garbage' });",
                  "    return;",
                  "  }",
                  "  if (mode === 'lowercase') {",
                  "    pm.request.headers.upsert({ key: 'authorization', value: 'Bearer ' + pm.environment.get('authToken') });",
                  "    return;",
                  "  }",
                  "  if (mode === 'inherit') return;",
                  "}",
                  "",
                  "function runStep(step) {",
                  "  return new Promise((resolve, reject) => {",
                  "    const hdr = { 'X-Student-Id': pm.environment.get('studentId') || '23127273' };",
                  "    if (step.content_type) hdr['Content-Type'] = step.content_type;",
                  "    if (step.auth_mode === 'user') hdr.Authorization = 'Bearer ' + pm.environment.get('authToken');",
                  "    if (step.auth_mode === 'admin') hdr.Authorization = 'Bearer ' + pm.environment.get('adminToken');",
                  "    if (step.auth_mode === 'cartFresh') hdr.Authorization = 'Bearer ' + pm.environment.get('cartFreshToken');",
                  "    if (step.extra_headers) {",
                  "      try { Object.entries(JSON.parse(step.extra_headers)).forEach(([k,v]) => { hdr[k] = v; }); } catch (e) {}",
                  "    }",
                  "    pm.sendRequest({ url: base + step.path, method: step.method, header: hdr, body: step.body ? { mode: 'raw', raw: step.body } : undefined }, (err, res) => {",
                  "      if (err) reject(err); else resolve(res);",
                  "    });",
                  "  });",
                  "}",
                  "",
                  "const pre = d.pre_steps && d.pre_steps.length > 2 ? JSON.parse(d.pre_steps) : [];",
                  "function runPreSteps(i) {",
                  "  if (i >= pre.length) return;",
                  "  const step = pre[i];",
                  "  const hdr = { 'X-Student-Id': pm.environment.get('studentId') || '23127273' };",
                  "  if (step.content_type) hdr['Content-Type'] = step.content_type;",
                  "  if (step.auth_mode === 'user') hdr.Authorization = 'Bearer ' + pm.environment.get('authToken');",
                  "  if (step.auth_mode === 'admin') hdr.Authorization = 'Bearer ' + pm.environment.get('adminToken');",
                  "  if (step.auth_mode === 'cartFresh') hdr.Authorization = 'Bearer ' + pm.environment.get('cartFreshToken');",
                  "  pm.sendRequest({ url: base + step.path, method: step.method, header: hdr, body: step.body ? { mode: 'raw', raw: step.body } : undefined }, () => runPreSteps(i + 1));",
                  "}",
                  "runPreSteps(0);",
                  "",
                  "pm.request.method = d.method;",
                  "const rawPath = d.path.startsWith('http') ? d.path : base + d.path;",
                  "pm.request.url = rawPath;",
                  "",
                  "if (d.content_type) pm.request.headers.upsert({ key: 'Content-Type', value: d.content_type });",
                  "else pm.request.headers.remove('Content-Type');",
                  "",
                  "applyAuth(d.auth_mode);",
                  "",
                  "if (d.extra_headers) {",
                  "  try {",
                  "    Object.entries(JSON.parse(d.extra_headers)).forEach(([k, v]) => pm.request.headers.upsert({ key: k, value: v }));",
                  "  } catch (e) {}",
                  "}",
                  "",
                  "if (d.body && d.body.length > 0) {",
                  "  pm.request.body = { mode: 'raw', raw: d.body };",
                  "} else {",
                  "  pm.request.body = undefined;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.iterationData.toObject();",
                  "const profile = d.assertion_profile;",
                  "const sid = pm.environment.get('studentId') || '23127273';",
                  "const base = pm.environment.get('baseUrl');",
                  "",
                  "function expectStatus(code) {",
                  "  pm.test('[SPEC] status ' + code, () => pm.response.to.have.status(Number(code)));",
                  "}",
                  "function expectOneOf(codes) {",
                  "  pm.test('[SPEC] status one of ' + codes, () => pm.expect(pm.response.code).to.be.oneOf(codes.map(Number)));",
                  "}",
                  "",
                  "switch (profile) {",
                  "  case 'status_404': expectStatus(404); break;",
                  "  case 'status_400': expectStatus(400); break;",
                  "  case 'status_401_403': expectOneOf([401,403]); break;",
                  "  case 'status_403': expectStatus(403); break;",
                  "  case 'status_429': expectStatus(429); break;",
                  "  case 'status_204': expectStatus(204); break;",
                  "  case 'status_404_or_405': expectOneOf([404,405]); break;",
                  "  case 'status_400_or_415': expectOneOf([400,415]); break;",
                  "  case 'status_200': expectStatus(200); break;",
                  "  case 'status_200_or_400': expectOneOf([200,400]); break;",
                  "  case 'status_400_or_404': expectOneOf([400,404]); break;",
                  "",
                  "  case 'fr06_s200_schema_full':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] required fields', () => { ['id','name','price','description','imageUrl','category_id'].forEach(k => pm.expect(pm.response.json()).to.have.property(k)); });",
                  "    pm.test('[SPEC] price is number', () => pm.expect(typeof pm.response.json().price).to.eql('number'));",
                  "    break;",
                  "  case 'fr06_s200_price_num':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] price is number', () => pm.expect(typeof pm.response.json().price).to.eql('number'));",
                  "    break;",
                  "  case 'fr06_s200_keychron':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] name contains Keychron', () => pm.expect(pm.response.json().name).to.include('Keychron'));",
                  "    break;",
                  "  case 'fr06_s200_cat2':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] category_id is 2', () => pm.expect(pm.response.json().category_id).to.eql(2));",
                  "    break;",
                  "  case 'fr06_detail_not_array':",
                  "    pm.test('[SPEC] detail not list array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('object'); pm.expect(pm.response.json()).to.not.be.an('array'); pm.expect(pm.response.json()).to.have.property('id'); });",
                  "    break;",
                  "  case 'fr06_not_array_only':",
                  "    pm.test('[SPEC] must not return array', () => pm.expect(pm.response.json()).to.not.be.an('array'));",
                  "    break;",
                  "  case 'fr06_schema_id': pm.test('[SPEC] id === 1', () => pm.expect(pm.response.json().id).to.eql(1)); break;",
                  "  case 'fr06_schema_name':",
                  "    pm.test('[SPEC] name non-empty string', () => { const n = pm.response.json().name; pm.expect(typeof n).to.eql('string'); pm.expect(n.length).to.be.above(0); });",
                  "    break;",
                  "  case 'fr06_schema_desc': pm.test('[SPEC] description string', () => pm.expect(typeof pm.response.json().description).to.eql('string')); break;",
                  "  case 'fr06_schema_img': pm.test('[SPEC] imageUrl URL', () => pm.expect(pm.response.json().imageUrl).to.match(/^http/)); break;",
                  "  case 'fr06_schema_cat': pm.test('[SPEC] category_id 1-3', () => pm.expect(pm.response.json().category_id).to.be.oneOf([1,2,3])); break;",
                  "  case 'fr06_schema_keys':",
                  "    pm.test('[SPEC] only expected keys', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['category_id','description','id','imageUrl','name','price'].sort()));",
                  "    break;",
                  "  case 'fr06_public_200':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] returns product', () => pm.expect(pm.response.json().id).to.eql(1));",
                  "    break;",
                  "  case 'fr06_sqli_reject': expectOneOf([400,404]); break;",
                  "  case 'fr06_sqli_db_intact':",
                  "    expectOneOf([400,404]);",
                  "    pm.sendRequest({ url: base + '/api/products', method: 'GET', header: { 'X-Student-Id': sid } }, (err, res) => {",
                  "      pm.test('[SPEC] products table intact', () => { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(200); pm.expect(JSON.parse(res.stream.toString())).to.be.an('array').that.is.not.empty; });",
                  "    });",
                  "    break;",
                  "  case 'fr06_xss_reject':",
                  "    expectOneOf([400,404]);",
                  "    pm.test('[SPEC] no script reflected', () => pm.expect(pm.response.text()).to.not.include('<script>'));",
                  "    break;",
                  "  case 'fr06_content_type': pm.test('[SPEC] Content-Type json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json')); break;",
                  "  case 'fr06_response_time':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "    break;",
                  "  case 'fr06_idempotent_p1':",
                  "    expectStatus(200);",
                  "    pm.collectionVariables.set('fr06_tc033_body', pm.response.text());",
                  "    break;",
                  "  case 'fr06_idempotent_p2':",
                  "    pm.test('[SPEC] identical body', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('fr06_tc033_body')));",
                  "    break;",
                  "  case 'fr06_chain_list_detail':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] list contains id 1', () => pm.expect(pm.response.json().some(p => p.id === 1)).to.be.true);",
                  "    pm.sendRequest({ url: base + '/api/products/1', method: 'GET', header: { 'X-Student-Id': sid } }, (err, res) => {",
                  "      pm.test('[SPEC] detail id=1', () => { pm.expect(err).to.be.null; pm.expect(JSON.parse(res.stream.toString()).id).to.eql(1); });",
                  "    });",
                  "    break;",
                  "  case 'fr06_parity_p1':",
                  "    pm.test('[SPEC] id=1 price number', () => pm.expect(typeof pm.response.json().price).to.eql('number'));",
                  "    pm.collectionVariables.set('fr06_ext006_p1', typeof pm.response.json().price);",
                  "    break;",
                  "  case 'fr06_parity_p2':",
                  "    pm.test('[SPEC] id=2 price number', () => pm.expect(typeof pm.response.json().price).to.eql('number'));",
                  "    pm.test('[SPEC] same type as id=1', () => pm.expect(pm.collectionVariables.get('fr06_ext006_p1')).to.eql('number'));",
                  "    break;",
                  "",
                  "  case 'fr07_s200_empty_cart':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] empty array', () => pm.expect(pm.response.json()).to.eql([]));",
                  "    break;",
                  "  case 'fr07_s200_array': pm.test('[SPEC] response is array', () => pm.expect(pm.response.json()).to.be.an('array')); break;",
                  "  case 'fr07_content_type': pm.test('[SPEC] Content-Type json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json')); break;",
                  "  case 'fr07_s200_added':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] message Added', () => pm.expect(pm.response.json().message).to.include('Added'));",
                  "    break;",
                  "  case 'fr07_cart_has_item':",
                  "    pm.test('[SPEC] cart has item', () => pm.expect(pm.response.json().length).to.be.at.least(1));",
                  "    pm.test('[SPEC] item schema', () => { const it = pm.response.json()[0]; ['id','name','price','quantity'].forEach(k => pm.expect(it).to.have.property(k)); });",
                  "    break;",
                  "  case 'fr07_price_number': pm.test('[SPEC] price number', () => pm.expect(typeof pm.response.json()[0].price).to.eql('number')); break;",
                  "  case 'fr07_qty_number': pm.test('[SPEC] quantity number', () => pm.expect(typeof pm.response.json()[0].quantity).to.eql('number')); break;",
                  "  case 'fr07_xss':",
                  "    expectOneOf([200,400]);",
                  "    pm.test('[SPEC] no script in response', () => pm.expect(pm.response.text()).to.not.include('<script>'));",
                  "    break;",
                  "  case 'fr07_duplicate_merge':",
                  "    pm.test('[SPEC] one row id=1', () => { const same = pm.response.json().filter(i => i.id === 1); pm.expect(same.length).to.eql(1); });",
                  "    pm.test('[SPEC] merged qty 2', () => { pm.expect(pm.response.json().filter(i => i.id === 1)[0].quantity).to.eql(2); });",
                  "    break;",
                  "  case 'fr07_dup_at_most_one':",
                  "    pm.test('[SPEC] at most one row per id', () => pm.expect(pm.response.json().filter(i => i.id === 1).length).to.be.at.most(1));",
                  "    break;",
                  "  case 'fr07_schema_all_keys':",
                  "    pm.test('[SPEC] all keys', () => pm.response.json().forEach(i => pm.expect(i).to.have.all.keys('id','name','price','quantity')));",
                  "    break;",
                  "  case 'fr07_response_time':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "    break;",
                  "  case 'fr07_cart_not_empty': pm.test('[SPEC] cart not empty', () => pm.expect(pm.response.json().length).to.be.above(0)); break;",
                  "  case 'fr07_multi_items': pm.test('[SPEC] >=2 items', () => pm.expect(pm.response.json().length).to.be.at.least(2)); break;",
                  "",
                  "  case 'fr16_s200_import_ok':",
                  "    expectStatus(200);",
                  "    pm.test('[SPEC] inserted >= 1', () => pm.expect(pm.response.json().inserted).to.be.at.least(1));",
                  "    pm.test('[SPEC] errors empty', () => pm.expect(pm.response.json().errors).to.eql([]));",
                  "    break;",
                  "  case 'fr16_missing_name_ok':",
                  "    pm.test('[SPEC] 400 or inserted 0', () => { const b = pm.response.json(); pm.expect(pm.response.code === 400 || b.inserted === 0).to.be.true; });",
                  "    break;",
                  "  case 'fr16_rollback': expectStatus(400); break;",
                  "  case 'fr16_schema_fields':",
                  "    pm.test('[SPEC] has message,inserted,errors', () => { ['message','inserted','errors'].forEach(k => pm.expect(pm.response.json()).to.have.property(k)); });",
                  "    break;",
                  "  case 'fr16_inserted_1': pm.test('[SPEC] inserted 1', () => pm.expect(pm.response.json().inserted).to.eql(1)); break;",
                  "  case 'fr16_inserted_2': pm.test('[SPEC] inserted 2', () => pm.expect(pm.response.json().inserted).to.eql(2)); break;",
                  "  case 'fr16_inserted_10': pm.test('[SPEC] inserted 10', () => pm.expect(pm.response.json().inserted).to.eql(10)); break;",
                  "  case 'fr16_no_script': pm.test('[SPEC] no script', () => pm.expect(pm.response.text()).to.not.include('<script>')); break;",
                  "  case 'fr16_response_time': pm.test('[SPEC] < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000)); break;",
                  "",
                  "  default:",
                  "    if (d.expected_status) expectStatus(d.expected_status);",
                  "    else pm.test('[SPEC] profile ' + profile, () => pm.expect.fail('Unknown assertion_profile: ' + profile));",
                  "}",
                  "",
                  "pm.test('[SPEC] tc ' + d.tc_id, () => pm.expect(d.tc_id).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}